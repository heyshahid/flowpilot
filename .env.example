# FlowPilot Production SaaS Environment Configuration Template
# COPY THIS FILE TO .env.local FOR DEVELOPMENT OR INJECT INTO YOUR PRODUCTION SECRETS MANAGER.
# NEVER COMMIT ACTUAL CREDENTIALS, KEYS, OR SECRETS TO VERSION CONTROL.

# -----------------------------------------------------------------------------
# 1. Server & Application Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://app.flowpilot.dev
NEXT_PUBLIC_API_URL=https://app.flowpilot.dev/api/v1

# -----------------------------------------------------------------------------
# 2. Database & Persistence (PostgreSQL)
# -----------------------------------------------------------------------------
# Direct connection string for Prisma migrations & single connection scripts
DIRECT_URL="postgresql://postgres:password@localhost:5432/flowpilot?sslmode=prefer"
# Pooled connection string for application runtime (e.g., PgBouncer / Neon / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/flowpilot?pgbouncer=true&connection_limit=20"

# -----------------------------------------------------------------------------
# 3. Distributed Queue & Caching (Redis)
# -----------------------------------------------------------------------------
REDIS_URL="redis://default:password@localhost:6379"
REDIS_TLS=false
WORKER_CONCURRENCY=10

# -----------------------------------------------------------------------------
# 4. Security & Cryptography
# -----------------------------------------------------------------------------
# 32-byte (64 hex characters) AES-256-GCM Master Key for Credential Vault encryption
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
FLOWPILOT_ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key_here

# Secret for signing session cookies and auth tokens
SESSION_SECRET=replace_with_secure_random_64_character_session_secret_here

# -----------------------------------------------------------------------------
# 5. Transactional Email (Verification, Notifications & Alerts)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_or_resend_api_key_here
SMTP_DEFAULT_FROM=FlowPilot <notifications@flowpilot.dev>

# -----------------------------------------------------------------------------
# 6. Commercial SaaS Billing & Subscriptions (Stripe)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key

# Stripe Price IDs for Subscription Tiers
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_placeholder
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_placeholder
STRIPE_TEAM_MONTHLY_PRICE_ID=price_team_monthly_placeholder
STRIPE_TEAM_YEARLY_PRICE_ID=price_team_yearly_placeholder

# -----------------------------------------------------------------------------
# 7. AI Providers
# -----------------------------------------------------------------------------
# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# 8. External Integrations & OAuth Applications
# -----------------------------------------------------------------------------
# Google Workspace / Sheets OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://app.flowpilot.dev/api/v1/oauth/google/callback

# Slack App Credentials
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# -----------------------------------------------------------------------------
# 9. Webhook Security & Rate Limiting
# -----------------------------------------------------------------------------
WEBHOOK_MAX_PAYLOAD_BYTES=1048576
WEBHOOK_DEFAULT_RATE_LIMIT=60
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# 10. Observability, Logging & Error Tracking (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare R2 / AWS S3 Object Storage (For large execution traces & file uploads)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=flowpilot-production-artifacts
