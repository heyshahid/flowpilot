# FlowPilot Environment Configuration Template

# Server Configuration
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security & Encryption
# 32-byte AES-256-GCM Master Key for Credential Vault encryption
FLOWPILOT_ENCRYPTION_KEY=flowpilot_production_vault_master_key_32_bytes_super_secret!

# Transactional Email (SMTP Integration)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here
SMTP_DEFAULT_FROM=notifications@flowpilot.dev

# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Telegram Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Workspace / Sheets Integration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google_sheets/callback

# Webhook Security
WEBHOOK_MAX_PAYLOAD_BYTES=1048576
WEBHOOK_DEFAULT_RATE_LIMIT=60
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
