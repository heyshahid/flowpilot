# FlowPilot Environment Configuration Template

# Server & Application
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security & Encryption (AES-256-GCM 32-byte Hex Key)
# Generate with: openssl rand -hex 32
FLOWPILOT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowpilot?schema=public"

# Optional: AI Provider (Gemini / OpenAI)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Optional: Transactional Email (Resend / SMTP)
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
